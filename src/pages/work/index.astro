---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sitemap from "../../components/Sitemap.astro";
import { site } from "../../data/site";
import { breadcrumbs } from "../../lib/schema";
import { getWork } from "../../lib/markdown";

const work = await getWork();
const description = "Case studies from buildIntersect: dealer WhatsApp operations, sales MIS on legacy systems, retail process redesign, human-in-the-loop automation and a company brain.";
---
<BaseLayout title="Work" description={description} pageKind="content" markdown="/work.md" schema={[
  {
    "@type": "CollectionPage",
    "@id": `${site.url}/work/#page`,
    url: `${site.url}/work/`,
    name: `Work | ${site.name}`,
    hasPart: work.map((e) => ({ "@id": `${site.url}/work/${e.id}/#article` })),
  },
  breadcrumbs([{ name: "Home", path: "/" }, { name: "Work", path: "/work/" }]),
]}>
  <main class="library-shell">
    <div class="ambient-grid" aria-hidden="true"></div>
    <section class="library-hero">
      <p class="eyebrow">Work</p>
      <h1>Work, stated plainly.</h1>
      <p class="library-intro">
        Client names are withheld. Where work is still in progress, the page says so, and the numbers describe scope until outcomes are measured.
      </p>
    </section>

    <section class="library-grid" aria-label="Case studies">
      {work.map((entry) => (
        <article class="library-card">
          <p class="card-eyebrow">{entry.data.sector}</p>
          <h2>{entry.data.title}</h2>
          <p>{entry.data.summary}</p>
          <div class="library-meta">
            <span>{entry.data.status}</span>
            {entry.data.metrics[0] && <span>{entry.data.metrics[0].value} {entry.data.metrics[0].label}</span>}
          </div>
          <a class="button button-primary" href={`/work/${entry.id}/`}>Read the case study</a>
        </article>
      ))}
    </section>
  </main>
  <Sitemap />
</BaseLayout>
