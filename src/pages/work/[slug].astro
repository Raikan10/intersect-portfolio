---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";
import { breadcrumbs, caseStudy } from "../../lib/schema";
import { getWork } from "../../lib/markdown";

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const path = `/work/${entry.id}/`;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary} markdown={`/work/${entry.id}.md`} ogType="article" schema={[
  caseStudy({ title: d.title, summary: d.summary, path, tags: d.tags }),
  breadcrumbs([{ name: "Home", path: "/" }, { name: "Work", path: "/work/" }, { name: d.title, path }]),
]}>
  <article class="wrap">
    <header class="page-head">
      <p class="crumbs"><a href="/">Home</a> / <a href="/work/">Work</a> / {d.sector}</p>
      <h1 class="display">{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <div class="metrics">
        {d.metrics.map((m) => (<div class="metric"><strong>{m.value}</strong><span>{m.label}</span></div>))}
      </div>
    </header>

    <div class="two-col">
      <div class="prose"><Content /></div>
      <aside>
        <dl class="facts">
          <div><dt>Client</dt><dd>{d.client}</dd></div>
          <div><dt>Sector</dt><dd>{d.sector}</dd></div>
          <div><dt>Status</dt><dd>{d.status}</dd></div>
          <div><dt>Topics</dt><dd>{d.tags.join(", ")}</dd></div>
        </dl>
      </aside>
    </div>
  </article>

  <section class="section">
    <div class="wrap">
      <div class="cta">
        <p class="eyebrow">Next case study</p>
        <h2 class="h2"><a href={`/work/${next.id}/`}>{next.data.title}</a></h2>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${site.email}?subject=A%20workflow%20to%20take%20apart`}>Talk about your workflow</a>
          <a class="btn" href="/work/">All work</a>
        </div>
      </div>
    </div>
  </section>
</Base>
