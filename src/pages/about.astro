---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Sitemap from "../components/Sitemap.astro";
import { site, founder } from "../data/site";
import { breadcrumbs, ids } from "../lib/schema";

const description = `${site.name} is an AI consulting practice founded by ${founder.name}: software engineer, operator and IESE MBA who runs distribution and retail businesses.`;
---
<BaseLayout title="About" description={description} pageKind="content" markdown="/about.md" schema={[
  { "@type": "AboutPage", "@id": `${site.url}/about/#page`, url: `${site.url}/about/`, name: `About ${site.name}`, mainEntity: { "@id": ids.person }, about: { "@id": ids.org } },
  breadcrumbs([{ name: "Home", path: "/" }, { name: "About", path: "/about/" }]),
]}>
  <main class="entry-shell">
    <div class="ambient-grid" aria-hidden="true"></div>
    <section class="library-hero">
      <p class="eyebrow">About</p>
      <h1>Built by an operator.</h1>
      <p class="library-intro">An AI consulting practice run by someone who runs businesses too.</p>
    </section>
    <About />
    <section class="library-section" aria-labelledby="background-h">
      <h2 id="background-h">{founder.name}</h2>
      <div class="library-grid library-grid-2">
        <article class="library-card">
          <p class="card-eyebrow">Background</p>
          <ul>{founder.background.map((b) => <li>{b}</li>)}</ul>
        </article>
        <article class="library-card">
          <p class="card-eyebrow">Why the name</p>
          <p>The useful work in a business happens where two things meet: operations and technology, a process and the person who owns it, a rule and its exception. That intersection is where we build.</p>
        </article>
      </div>
    </section>
  </main>
  <Contact />
  <Sitemap />
</BaseLayout>
