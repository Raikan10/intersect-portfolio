---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Sandbox" description="We don't build sandboxes here. We do AI transformations." pageKind="content" noindex>
  <main class="void-shell">
    <section class="void-content">
      <p class="eyebrow">/sandbox</p>
      <h1 class="void-title">No sandboxes</h1>
      <p>We don't build sandboxes here. No demo playgrounds, no toy pilots that never leave the box. We do AI transformations: real work, in your real business, with results you can measure.</p>
      <a href="/" class="button">See what we do</a>
    </section>
  </main>
</BaseLayout>
