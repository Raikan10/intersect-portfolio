---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sitemap from "../components/Sitemap.astro";
import { site, coimbatore, industries } from "../data/site";
import { breadcrumbs } from "../lib/schema";
---
<BaseLayout title="AI Consulting in Coimbatore, Tamil Nadu" description={coimbatore.description} pageKind="content" markdown="/ai-consulting-coimbatore.md" schema={[
  {
    "@type": "WebPage",
    "@id": `${site.url}/ai-consulting-coimbatore/#page`,
    url: `${site.url}/ai-consulting-coimbatore/`,
    name: "AI consulting in Coimbatore",
    about: { "@id": `${site.url}/#organization` },
    spatialCoverage: { "@type": "Place", name: "Coimbatore, Tamil Nadu, India" },
  },
  breadcrumbs([{ name: "Home", path: "/" }, { name: "AI consulting in Coimbatore", path: "/ai-consulting-coimbatore/" }]),
]}>
  <main class="library-shell">
    <div class="ambient-grid" aria-hidden="true"></div>
    <section class="library-hero">
      <p class="eyebrow">Coimbatore, Tamil Nadu</p>
      <h1>AI consulting in Coimbatore.</h1>
      {coimbatore.intro.map((p) => <p class="library-intro">{p}</p>)}
    </section>

    <section class="library-section" aria-labelledby="offers-h">
      <h2 id="offers-h">What we do for businesses in the region.</h2>
      <div class="library-grid library-grid-2">
        {coimbatore.offers.map((o) => (
          <article class="library-card">
            <h3 class="card-title">{o.name}</h3>
            <p>{o.body}</p>
            <a class="button" href={o.href}>Details</a>
          </article>
        ))}
      </div>
    </section>

    <section class="library-section" aria-labelledby="ind-h">
      <h2 id="ind-h">Industries we know.</h2>
      <div class="library-grid library-grid-2">
        {industries.map((i) => (
          <article class="library-card">
            <h3 class="card-title">{i.name}</h3>
            <p>{i.pain}</p>
            <a class="button" href={`/insights/${i.insight}/`}>Read more</a>
          </article>
        ))}
      </div>
    </section>

    <div class="entry-next">
      <a class="button button-primary" href="/contact/">Book a free AI readiness assessment</a>
      <a class="button" href="/work/">See the case studies</a>
    </div>
  </main>
  <Sitemap />
</BaseLayout>
