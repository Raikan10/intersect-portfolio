---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sitemap from "../components/Sitemap.astro";
import { site, services, principles } from "../data/site";
import { breadcrumbs } from "../lib/schema";

const description = "How buildIntersect engagements work: a free workflow teardown, fixed-scope builds, a company brain and MIS, and advisory for owners and leadership teams.";
const serviceNodes = services.map((s) => ({
  "@type": "Service",
  "@id": `${site.url}/services/#${s.id}`,
  name: s.name,
  description: `${s.summary} ${s.outputs.join(". ")}.`,
  provider: { "@id": `${site.url}/#organization` },
  areaServed: ["India", "United Arab Emirates", "United Kingdom"],
  serviceType: "AI strategy and implementation",
}));
---
<BaseLayout title="Services" description={description} pageKind="content" markdown="/services.md" schema={[...serviceNodes, breadcrumbs([{ name: "Home", path: "/" }, { name: "Services", path: "/services/" }])]}>
  <main class="library-shell">
    <div class="ambient-grid" aria-hidden="true"></div>
    <section class="library-hero">
      <p class="eyebrow">Services</p>
      <h1>Start with one workflow.</h1>
      <p class="library-intro">
        Every engagement has a defined output, a price agreed up front, and a payback case you can check. It ends with something your team runs without us.
      </p>
    </section>

    <section class="library-grid library-grid-2" aria-label="Services">
      {services.map((s) => (
        <article class="library-card" id={s.id}>
          <p class="card-eyebrow">{s.duration}</p>
          <h2>{s.name}</h2>
          <p>{s.summary}</p>
          <ul>{s.outputs.map((o) => <li>{o}</li>)}</ul>
          <div class="library-meta"><span>{s.price}</span></div>
        </article>
      ))}
    </section>

    <section class="library-section" id="principles" aria-labelledby="principles-h">
      <h2 id="principles-h">What stays the same in every engagement.</h2>
      <div class="library-grid">
        {principles.map((p) => (
          <article class="library-card" id={p.id}>
            <h3 class="card-title">{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </section>

    <div class="entry-next">
      <a class="button button-primary" href={`mailto:${site.email}?subject=A%20workflow%20to%20take%20apart`}>Pick a workflow with us</a>
      <a class="button" href="/work/">See the work</a>
    </div>
  </main>
  <Sitemap />
</BaseLayout>
