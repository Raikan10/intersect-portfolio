---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sitemap from "../components/Sitemap.astro";
import { site, services, principles, industries, process } from "../data/site";
import { breadcrumbs } from "../lib/schema";

const description = "AI consulting services from buildIntersect in Coimbatore, India: a free AI readiness assessment, fixed-price AI automation, AI reporting and a company knowledge base, and advisory for owners and investors.";
const serviceNodes = services.map((s) => ({
  "@type": "Service",
  "@id": `${site.url}/services/#${s.id}`,
  name: s.name,
  description: `${s.short} ${s.summary} ${s.outputs.join(". ")}.`,
  provider: { "@id": `${site.url}/#organization` },
  areaServed: site.areaServed.map((name) => ({ "@type": "Place", name })),
  serviceType: "AI consulting",
}));
---
<BaseLayout title="AI Consulting Services" description={description} pageKind="content" markdown="/services.md" schema={[...serviceNodes, breadcrumbs([{ name: "Home", path: "/" }, { name: "Services", path: "/services/" }])]}>
  <main class="library-shell">
    <div class="ambient-grid" aria-hidden="true"></div>
    <section class="library-hero">
      <p class="eyebrow">Services</p>
      <h1>AI consulting, built to be used.</h1>
      <p class="library-intro">
        Every engagement starts with one problem and ends with something your team runs without us. A defined output, a price agreed up front, and a payback case you can check.
      </p>
    </section>

    <section class="library-grid library-grid-2" aria-label="Services">
      {services.map((s) => (
        <article class="library-card" id={s.id}>
          <p class="card-eyebrow">{s.duration}</p>
          <h2>{s.name}</h2>
          <p>{s.short} {s.summary}</p>
          <ul>{s.outputs.map((o) => <li>{o}</li>)}</ul>
          <div class="library-meta"><span>{s.price}</span></div>
        </article>
      ))}
    </section>

    <section class="library-section" id="process" aria-labelledby="process-h">
      <h2 id="process-h">How an engagement runs.</h2>
      <ol class="library-grid library-steps">
        {process.map((p, i) => (
          <li class="library-card">
            <p class="card-eyebrow">Step {i + 1}</p>
            <h3 class="card-title">{p.name}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="library-section" id="industries" aria-labelledby="industries-h">
      <h2 id="industries-h">Industries we work with.</h2>
      <div class="library-grid library-grid-2">
        {industries.map((i) => (
          <article class="library-card" id={i.id}>
            <h3 class="card-title">{i.name}</h3>
            <p>{i.pain}</p>
            <ul>{i.firstProjects.map((p) => <li>{p}</li>)}</ul>
            <a class="button" href={`/insights/${i.insight}/`}>Read more</a>
          </article>
        ))}
      </div>
    </section>

    <section class="library-section" id="principles" aria-labelledby="principles-h">
      <h2 id="principles-h">What stays the same in every engagement.</h2>
      <div class="library-grid">
        {principles.map((p) => (
          <article class="library-card" id={p.id}>
            <h3 class="card-title">{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </section>

    <div class="entry-next">
      <a class="button button-primary" href="/contact/">Book a free AI readiness assessment</a>
      <a class="button" href="/work/">See the case studies</a>
    </div>
  </main>
  <Sitemap />
</BaseLayout>
