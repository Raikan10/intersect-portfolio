---
import Base from "../layouts/Base.astro";
import FlowDiagram from "../components/FlowDiagram.astro";
import WorkCard from "../components/WorkCard.astro";
import { site, principles, services, audiences, faqs } from "../data/site";
import { faqGraph } from "../lib/schema";
import { getWork } from "../lib/markdown";

const work = await getWork();
---
<Base markdown="/index.md" schema={[faqGraph()]}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow rise">AI strategy and builds · Coimbatore, India</p>
        <h1 class="display rise rise-2">AI for businesses that <em>run on operations.</em></h1>
        <p class="lede rise rise-3">
          {site.name} is a small practice led by Ajay Rajnikanth. We take one workflow apart, automate the parts that are completely standard, route the exceptions to the right person, and stay until your team actually uses it.
        </p>
        <div class="actions rise rise-3">
          <a class="btn btn-primary" href="#contact">Pick a workflow with us</a>
          <a class="btn" href="/work/">See the work</a>
        </div>
        <p class="hero-note">First workflow teardown has no fee. You keep the plan.</p>
      </div>
      <FlowDiagram />
    </div>
  </section>

  <section class="section" aria-labelledby="who">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Who it's for</p>
        <h2 id="who" class="h2">Operators first. Technology second.</h2>
        <p class="lede">Most problems we see are not a lack of intelligence. They are price lists in five places, approvals stuck in WhatsApp, and numbers re-typed between systems. That is where the hours go.</p>
      </div>
      <ul class="audience">
        {audiences.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="how">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How we work</p>
        <h2 id="how" class="h2">Six rules we hold ourselves to.</h2>
      </div>
      <ol class="principles">
        {principles.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="services">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2 id="services" class="h2">Start with one workflow. End with something your team runs.</h2>
      </div>
      <div class="grid-2">
        {services.map((s) => (
          <article class="card" id={s.id}>
            <div class="meta">
              <span class="pill">{s.duration}</span>
              <span class="pill pill-accent">{s.price}</span>
            </div>
            <h3>{s.name}</h3>
            <p class="muted">{s.summary}</p>
          </article>
        ))}
      </div>
      <p class="actions"><a class="btn" href="/services/">How engagements work</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="work">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2 id="work" class="h2">What we built, what it changed, and what we chose not to do.</h2>
        <p class="lede">Client names are withheld. Work still in progress is labelled as such.</p>
      </div>
      <div class="work-list">
        {work.slice(0, 3).map((entry) => <WorkCard entry={entry} />)}
      </div>
      <p class="actions"><a class="btn" href="/work/">All case studies</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="faq">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq" class="h2">Straight answers.</h2>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-h">
    <div class="wrap">
      <div class="cta">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-h" class="h2">Which workflow costs you the most hours?</h2>
        <p class="lede">Send one line about it. Ajay replies personally, and the first half-day teardown has no fee.</p>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${site.email}?subject=A%20workflow%20to%20take%20apart`}>{site.email}</a>
          <a class="btn" href={site.linkedin} rel="me noopener">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</Base>
