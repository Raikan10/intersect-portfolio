---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlowShader from "../components/GlowShader.astro";
import D3Graph from "../components/D3Graph.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Sitemap from "../components/Sitemap.astro";
import "../styles/components/Hero.css";
import "../styles/components/Projects.css";
import { services, principles, industries, process, faqs } from "../data/site";
import { faqGraph } from "../lib/schema";
import { getWork, getInsights } from "../lib/markdown";

const work = await getWork();
const insights = (await getInsights()).slice(0, 3);

// The graph: case studies, services and principles as nodes, joined where
// a case study used a service or was shaped by a principle.
const graphNodes = [
  ...work.map((e) => ({ id: e.id, name: e.data.title, type: "Case study", summary: e.data.result, href: `/work/${e.id}/` })),
  ...services.map((s) => ({ id: s.id, name: s.name, type: "Service", summary: s.short, href: `/services/#${s.id}` })),
  ...principles.map((p) => ({ id: p.id, name: p.title, type: "Principle", summary: p.body, href: `/services/#${p.id}` })),
];
const graphLinks = [
  ...work.flatMap((e) => [
    ...e.data.services.map((target) => ({ source: e.id, target })),
    ...e.data.principles.map((target) => ({ source: e.id, target })),
  ]),
  { source: "ai-readiness-assessment", target: "ai-automation" },
  { source: "ai-automation", target: "ai-reporting" },
];
---

<BaseLayout markdown="/index.md" schema={[faqGraph()]}>
  <main class="installation-shell">
    <section class="hero-installation" id="top">
      <GlowShader />
      <div class="hero-panel">
        <div class="hero-center">
          <p class="strategy-ai" aria-hidden="true">
            <span class="strategy-txt">STRATEGY</span>
            <svg class="strategy-logo" viewBox="0 0 851 847" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="logo-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="rgba(243, 237, 230, 0.95)" />
                  <stop offset="40%" stop-color="rgba(223, 217, 210, 0.85)" />
                  <stop offset="100%" stop-color="rgba(243, 237, 230, 0.9)" />
                </linearGradient>
              </defs>
              <path fill-rule="evenodd" clip-rule="evenodd" d="M715.811 311.017L523.907 346.329L545.44 323.628L698.71 288.317L829.883 24.0387L440.616 432.81L448.712 439.553L448.723 439.562L448.734 439.573L828.012 822.655L697.444 557.856L537.841 527.93L509.973 500.185L714.544 535.156L839.947 839.087L827.492 826.607L431.919 456.369L425.738 449.265L419.558 456.369L17.6332 830.975L9.21338 839.087L137.492 535.063L137.548 535.054L342.443 500.028L314.342 528.004L314.32 528.026L314.288 528.032L154.736 557.949L20.4398 824.527L402.742 439.573L402.753 439.562L402.765 439.553L410.86 432.81L323.411 340.573L321.037 340.11L326.936 346.329L135.032 311.017L9.62917 7.08665L18.496 15.9145L425.738 419.408L832.347 15.9145L841.213 7.08665L715.811 311.017ZM24.9095 30.4867L152.132 288.317L305.402 323.628L320.544 339.59L322.918 340.053L21.1674 23.6227L24.9095 30.4867Z" fill="url(#logo-gradient)"/>
            </svg>
            <span class="ai-txt">AI</span>
          </p>
          <h1 class="hero-statement">AI consulting and automation for growing businesses.</h1>
          <p class="hero-sub">Based in Coimbatore, India. Working with owner-run companies across India, the UAE and the UK.</p>
        </div>
        <a href="#about" class="scroll-indicator" aria-label="Scroll to about">
          <div class="mouse-frame">
            <div class="scroll-dot"></div>
          </div>
          <span>Scroll</span>
        </a>
      </div>
    </section>

    <About />

    <section class="scroll-graph" id="work">
      <div class="graph-intro">
        <p class="eyebrow">Case studies</p>
        <h2>Where the work intersects.</h2>
        <p>
          Each node is a case study, a service or a principle. Lines show where they meet. Hover to read, click to open.
        </p>
      </div>

      <div class="graph-frame">
        <D3Graph nodes={graphNodes} links={graphLinks} />
      </div>

      <div class="capability-grid capability-grid--work">
        {work.map((entry) => (
          <a class="capability-card" href={`/work/${entry.id}/`}>
            <span class="card-type">{entry.data.sector} · {entry.data.status}</span>
            <h3 class="card-title">{entry.data.title}</h3>
            <p class="card-summary">{entry.data.result}</p>
            <span class="card-arrow" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="scroll-graph" id="services">
      <div class="graph-intro">
        <p class="eyebrow">Services</p>
        <h2>AI consulting, built to be used.</h2>
        <p>Every engagement has a defined output, a price agreed up front, and a payback case you can check.</p>
      </div>
      <div class="capability-grid capability-grid--services">
        {services.map((s) => (
          <a class="capability-card" href={`/services/#${s.id}`}>
            <span class="card-type">{s.duration}</span>
            <h3 class="card-title">{s.name}</h3>
            <p class="card-summary">{s.short}</p>
            <span class="card-price">{s.price}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="scroll-graph" id="industries">
      <div class="graph-intro">
        <p class="eyebrow">Who we work with</p>
        <h2>AI for the businesses that keep India running.</h2>
        <p>Owner-run and mid-size companies with 20 to 500 people, usually running on Tally or an ERP, a lot of Excel, and WhatsApp.</p>
      </div>
      <div class="capability-grid capability-grid--services">
        {industries.map((i) => (
          <a class="capability-card" href={`/insights/${i.insight}/`}>
            <span class="card-type">Industry</span>
            <h3 class="card-title">{i.name}</h3>
            <p class="card-summary">{i.pain}</p>
            <p class="card-list">Typical first projects: {i.firstProjects.join("; ")}.</p>
          </a>
        ))}
      </div>
    </section>

    <section class="scroll-graph" id="process">
      <div class="graph-intro">
        <p class="eyebrow">How an engagement runs</p>
        <h2>Assess, build, run.</h2>
      </div>
      <ol class="capability-grid capability-grid--steps">
        {process.map((p, i) => (
          <li class="capability-card">
            <span class="card-type">Step {i + 1}</span>
            <h3 class="card-title">{p.name}</h3>
            <p class="card-summary">{p.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="scroll-graph" id="insights">
      <div class="graph-intro">
        <p class="eyebrow">Insights</p>
        <h2>Practical answers on AI in business.</h2>
        <p>Short, practical notes from running and building for operating businesses. <a class="text-link" href="/insights/">All insights</a></p>
      </div>
      <div class="capability-grid">
        {insights.map((e) => (
          <a class="capability-card" href={`/insights/${e.id}/`}>
            <span class="card-type">{e.data.category}</span>
            <h3 class="card-title">{e.data.title}</h3>
            <p class="card-summary">{e.data.description}</p>
            <span class="card-arrow" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="scroll-graph" id="faq">
      <div class="graph-intro">
        <p class="eyebrow">Questions</p>
        <h2>Straight answers.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <Contact />
    <Sitemap />
  </main>
</BaseLayout>
