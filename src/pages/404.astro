---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist." noindex>
  <div class="wrap">
    <header class="page-head">
      <p class="crumbs">404</p>
      <h1 class="display">This page doesn't exist.</h1>
      <p class="lede">The link may be from the old site. Try the <a href="/">home page</a>, the <a href="/work/">work</a>, or <a href="/llms.txt">llms.txt</a> if you are an agent.</p>
    </header>
  </div>
  <div class="section-spacer"></div>
</Base>
