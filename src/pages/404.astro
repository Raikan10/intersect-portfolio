---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" description="This page does not exist." pageKind="content" noindex>
  <main class="void-shell">
    <section class="void-content">
      <p class="eyebrow">System error 404</p>
      <h1 class="void-title">Void</h1>
      <p>This node does not exist in the system. It may have moved with the redesign. Agents can start from <a href="/llms.txt">llms.txt</a>.</p>
      <a href="/" class="button">Return to source</a>
    </section>
  </main>
</BaseLayout>
