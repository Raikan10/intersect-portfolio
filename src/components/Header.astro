---
import Mark from "./Mark.astro";
import { nav, site } from "../data/site";
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <Mark />
      <span>build<b>Intersect</b></span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} class={item.href === "/about/" ? "hide-sm" : undefined} aria-current={path.startsWith(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
      <a class="btn" href="/#contact">Talk to us</a>
    </nav>
  </div>
</header>
