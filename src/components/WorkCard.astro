---
import type { CollectionEntry } from "astro:content";
interface Props { entry: CollectionEntry<"work"> }
const { entry } = Astro.props;
const d = entry.data;
---
<a class="work-card" href={`/work/${entry.id}/`}>
  <div class="hero-copy">
    <div class="meta">
      <span class="pill">{d.sector}</span>
      <span class="pill pill-accent">{d.status}</span>
    </div>
    <h3>{d.title}</h3>
    <p>{d.summary}</p>
    <span class="arrow">Read the case study →</span>
  </div>
  <div class="metrics">
    {d.metrics.map((m) => (
      <div class="metric"><strong>{m.value}</strong><span>{m.label}</span></div>
    ))}
  </div>
</a>
