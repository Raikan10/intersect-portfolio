---
import { Image } from "astro:assets";
import portrait from "../assets/portrait.png";
import "../styles/components/About.css";
---

<section id="about" class="about-section">
  <div class="about-container">
    <div class="about-content">
      <div class="about-text-wrapper">
        <p class="eyebrow">The practice</p>
        <h2 class="about-title">Strategy × AI × Systems</h2>
        <div class="about-description">
          <p>
            buildIntersect is a small AI strategy and build practice. I run operations and IT across a group of distribution and retail businesses in South India, and most of what I build for clients was tested there first.
          </p>
          <p>
            The work starts with one workflow. We map how it actually runs, automate the parts that are completely standard, route the exceptions to the right person, and stay until the team uses it. Technology is the supporting actor. Operations is the main character.
          </p>
        </div>
        <div class="about-stats">
          <div class="stat-item">
            <span class="stat-label">Focus</span>
            <span class="stat-value">Operating businesses</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Method</span>
            <span class="stat-value">One workflow at a time</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Outcome</span>
            <span class="stat-value">Steps removed</span>
          </div>
        </div>
      </div>
      
      <div class="about-visual">
        <div class="portrait-frame">
          <Image 
            src={portrait} 
            alt="Ajay Rajnikanth, founder of buildIntersect" 
            class="portrait-img" 
            width={800} 
            height={1000}
            format="webp"
            quality="high"
          />
          <div class="frame-overlay"></div>
          <div class="geometric-decoration top-right"></div>
          <div class="geometric-decoration bottom-left"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Simple intersection observer for entrance animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.2 });

  const aboutSection = document.querySelector('.about-section');
  if (aboutSection) observer.observe(aboutSection);
</script>
