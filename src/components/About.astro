---
import "../styles/components/About.css";
import { site } from "../data/site";

const facts = [
  { label: "Based in", value: `${site.location.city}, ${site.location.region}, India` },
  { label: "On site", value: "Coimbatore, Tiruppur, Erode, Salem, Chennai, Bengaluru" },
  { label: "Remote", value: "Across India, the UAE and the UK" },
  { label: "Clients", value: "Owner-run and mid-size businesses, 20 to 500 people" },
  { label: "Pricing", value: "Free first assessment, then fixed price" },
];
---

<section id="about" class="about-section">
  <div class="about-container">
    <div class="about-content">
      <div class="about-text-wrapper">
        <p class="eyebrow">The practice</p>
        <h2 class="about-title">Strategy × AI × Systems</h2>
        <div class="about-description">
          <p>
            buildIntersect is an AI consulting practice in Coimbatore, India. We run distribution and retail businesses in South India ourselves, and most of what we build for clients was tested there first.
          </p>
          <p>
            The work starts with one problem that costs your team hours every week. We map how it actually runs, automate the parts that are completely standard, send the exceptions to the right person, and stay until the team uses it. Technology is the supporting actor. Operations is the main character.
          </p>
        </div>
        <div class="about-stats">
          <div class="stat-item">
            <span class="stat-label">Focus</span>
            <span class="stat-value">Operating businesses</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Method</span>
            <span class="stat-value">One problem at a time</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Outcome</span>
            <span class="stat-value">Hours returned</span>
          </div>
        </div>
      </div>

      <dl class="about-facts">
        {facts.map((f) => (
          <div class="about-fact">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<script>
  // Simple intersection observer for entrance animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.2 });

  const aboutSection = document.querySelector('.about-section');
  if (aboutSection) observer.observe(aboutSection);
</script>
